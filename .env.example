DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# Used by compose.registry.yaml; pin a release tag or an image digest.
PROBE_IMAGE=ghcr.io/gfavre/probe:1.0.4
ALLOWED_HOSTS=status.example.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://status.example.com
HTTPS=true
# Enable only behind a proxy that overwrites X-Forwarded-Proto and X-Forwarded-For.
TRUST_PROXY_HEADERS=true
# Start with one hour; increase only after verifying HTTPS end to end.
SECURE_HSTS_SECONDS=3600
POSTGRES_DB=uptime
POSTGRES_USER=uptime
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
CELERY_BROKER_URL=redis://redis:6379/0
# Shared production authentication rate limits; uses the existing Redis service.
CACHE_URL=redis://redis:6379/1
HTTP_TIMEOUT=10
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=alerts@example.com
EMAIL_TO=
POSTMARK_MESSAGE_STREAM=outbound
# Optional first Google account bootstrap. Other Google accounts require an invitation.
OWNER_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Global notification credentials; each probe selects one channel.
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PUBLIC_URL=https://status.example.com
# Optional stable Fernet key; otherwise derived from DJANGO_SECRET_KEY.
PLATFORM_ENCRYPTION_KEY=

# History retention (days). Nightly compaction runs at 02:00 Europe/Zurich.
CHECK_RETENTION_DAYS=7
FAILURE_RETENTION_DAYS=30
HOURLY_RETENTION_DAYS=30
DAILY_RETENTION_DAYS=365

# Optional error reporting for Django and Celery. Leave empty to disable.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
